Function RemoveContentInBrackets(inputString As String) As String
    Dim regex As Object
    Set regex = CreateObject("VBScript.RegExp")
    With regex
        .Global = True
        .IgnoreCase = True
        .MultiLine = True
        .Pattern = "[\[\(][^\]\)]*[\]\)]" ' Matches anything within parentheses or square brackets
        RemoveContentInBrackets = .Replace(inputString, "")
    End With
End Function

Function RemoveTextAfterSpace(inputString As String) As String
    Dim spacePosition As Integer
    spacePosition = InStr(inputString, " ")
    If spacePosition > 0 Then
        RemoveTextAfterSpace = Left(inputString, spacePosition - 1)
    Else
        RemoveTextAfterSpace = inputString
    End If
End Function

Function ConvertBudgetToNumeric(budget As String) As String
    On Error GoTo ErrorHandler
    
    Dim value As String
    Dim multiplier As Double
    Dim regex As Object
    Dim matches As Object
    
    ' Initialize regular expression object
    Set regex = CreateObject("VBScript.RegExp")
    regex.IgnoreCase = True
    regex.Global = True
    
    ' Remove non-numeric characters from the budget string
    budget = Replace(budget, ",", "") ' Remove commas
    budget = Replace(budget, "$", "") ' Remove dollar sign
    
    ' Search for numerical value in the budget string using regular expression
    regex.Pattern = "(\d+(\.\d+)?)"
    Set matches = regex.Execute(budget)
    
    ' Extract numerical value from the first match
    If matches.Count > 0 Then
        value = matches(0)
    Else
        ' If no numerical value found, return empty string
        ConvertBudgetToNumeric = ""
        Exit Function
    End If
    
    ' Check for presence of "million" or "billion" in the budget string
    If InStr(1, budget, "million", vbTextCompare) > 0 Then
        multiplier = 1000000
    ElseIf InStr(1, budget, "billion", vbTextCompare) > 0 Then
        multiplier = 1000000000
    Else
        ' If no specific unit mentioned, return the value as is
        multiplier = 1
    End If
    
    ' Perform multiplication using string manipulation
    value = CStr(CDbl(value) * multiplier)
    
    ' Format the value with commas as necessary
    ConvertBudgetToNumeric = FormatNumber(value, 0)
    
    Exit Function
    
ErrorHandler:
    ' Handle errors
    MsgBox "Error occurred: " & Err.Description
    ConvertBudgetToNumeric = ""
End Function

' Function to process text data in columns (producer, writer, director, starring)
Function ProcessTextData(textData As String) As String
    Dim dataArray() As String
    Dim i As Integer
    
    ' Split the string by paragraph break
    dataArray = Split(textData, vbCrLf)
    
    ' Loop through the array and trim each element
    For i = LBound(dataArray) To UBound(dataArray)
        dataArray(i) = Trim(dataArray(i))
    Next i
    
    ' Join the array elements with commas
    ProcessTextData = Join(dataArray, ", ")
End Function

Function RemoveCommas(inputString As String) As String
    RemoveCommas = Replace(inputString, ",", "")
End Function
